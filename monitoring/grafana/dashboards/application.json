        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cahuita-prometheus"
      },
      "description": "UP means metrics are reachable, not that forecasts are usable.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cahuita-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"cahuita\",namespace=~\"${namespace}\",pod=~\"${pod}\"}",
          "legendFormat": "{{pod}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
