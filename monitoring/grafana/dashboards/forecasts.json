        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cahuita-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"cahuita\"}, namespace)",
          "refId": "VariableQuery"
        },
        "definition": "label_values(up{job=\"cahuita\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {
          "text": "cahuita-conditions",
          "value": "cahuita-conditions"
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cahuita-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"cahuita\",namespace=~\"${namespace}\"}, pod)",
          "refId": "VariableQuery"
        },
        "definition": "label_values(up{job=\"cahuita\",namespace=~\"${namespace}\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "location",
        "label": "Location",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cahuita-prometheus"
        },
        "query": {
          "query": "label_values(forecast_data_usable{job=\"cahuita\",namespace=~\"${namespace}\",pod=~\"${pod}\"}, location_id)",
          "refId": "VariableQuery"
        },
        "definition": "label_values(forecast_data_usable{job=\"cahuita\",namespace=~\"${namespace}\",pod=~\"${pod}\"}, location_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "cahuita",
          "value": [
            "cahuita"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
