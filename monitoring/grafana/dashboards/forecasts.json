    {
      "id": 4,
      "title": "Download age",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cahuita-prometheus"
      },
      "description": "Age since the last validated download, not the weather model run time. Reference thresholds match production: 30 minutes stale, six hours expired. The usable-data metric is authoritative, including earlier loss of future forecast hours. No data is distinct from zero. Current observations require a successful exporter scrape; gaps are not connected.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cahuita-prometheus"
          },
          "editorMode": "code",
          "expr": "(forecast_cache_age_seconds{job=\"cahuita\",namespace=~\"${namespace}\",pod=~\"${pod}\",location_id=~\"${location}\",source=~\"${source}\"}) and on(job,namespace,pod,container,instance) (up{job=\"cahuita\",namespace=~\"${namespace}\",pod=~\"${pod}\"} == 1)",
          "legendFormat": "{{location_id}} / {{source}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1800
              },
              {
                "color": "red",
                "value": 21600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Last valid download",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cahuita-prometheus"
      },
      "description": "Last validated download shown in the dashboard timezone. Absent before the first successful download. No data is distinct from zero. Current observations require a successful exporter scrape; gaps are not connected.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cahuita-prometheus"
          },
          "editorMode": "code",
          "expr": "((forecast_last_success_timestamp_seconds{job=\"cahuita\",namespace=~\"${namespace}\",pod=~\"${pod}\",location_id=~\"${location}\",source=~\"${source}\"}) and on(job,namespace,pod,container,instance) (up{job=\"cahuita\",namespace=~\"${namespace}\",pod=~\"${pod}\"} == 1)) * 1000",
          "legendFormat": "{{location_id}} / {{source}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last valid download"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "container": true,
              "instance": true,
              "__name__": true
            },
            "indexByName": {
              "location_id": 0,
              "source": 1,
              "Value": 2
            },
            "renameByName": {
              "location_id": "Location",
              "source": "Source",
              "Value": "Last valid download"
            }
          }
        }
      ]
    },
