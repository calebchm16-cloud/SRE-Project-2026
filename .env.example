# Optional; defaults are sufficient for local development.
CAHUITA_DATABASE_PATH=data/cache.sqlite3
# CAHUITA_LOCATIONS_FILE=config/locations.example.json
CAHUITA_REFRESH_SECONDS=900
CAHUITA_STALE_SECONDS=1800
CAHUITA_EXPIRE_SECONDS=21600
CAHUITA_REQUEST_TIMEOUT_SECONDS=10
CAHUITA_RETRY_DELAY_SECONDS=0.5
CAHUITA_HEARTBEAT_SECONDS=1
CAHUITA_WEATHER_BASE_URL=https://api.open-meteo.com
CAHUITA_MARINE_BASE_URL=https://marine-api.open-meteo.com
CAHUITA_LOG_LEVEL=INFO
# Optional full OTLP/HTTP traces URL; no export when absent.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
CAHUITA_TRACE_SAMPLE_RATIO=1.0
